{
    "name": "@bnqkl/server-util",
    "version": "0.0.6",
    "description": "bnqkl server util",
    "type": "commonjs",
    "keywords": [
        "bnqkl",
        "common"
    ],
    "private": true,
    "author": "",
    "license": "ISC",
    "files": [
        "build"
    ],
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "prepare": "husky install",
        "build": "tsc --build ./tsconfig.json",
        "build:dev": "tsc --build ./tsconfig.json --watch",
        "lsts": "node ./scripts/listAllFile.js",
        "clear": "node ./scripts/rmBuild.js",
        "rebuild": "npm run clear && npm run build",
        "format": "prettier --write \"packages/**/*.ts\"",
        "start": "node packages/wallet/build/src/main.js",
        "lint": "eslint \"{packages}/**/*.ts\" --fix",
        "publ:force": "lerna publish --force-publish"
    },
    "dependencies": {},
    "devDependencies": {
        "husky": "^8.0.1",
        "prettier": "^2.3.2",
        "source-map-support": "^0.5.20",
        "ts-jest": "28.0.8",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.1.0",
        "typescript": "^4.7.4"
    }
}
